{
  "name": "jira-portal-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portal / HTML form -> Jira create and update service",
  "main": "server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "build:css": "tailwindcss -i src/styles.css -o public/app.css --minify",
    "watch:css": "tailwindcss -i src/styles.css -o public/app.css --watch",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@netlify/blobs": "^11.1.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "serverless-http": "^3.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
