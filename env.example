JIRA_BASE_URL=https://powerconnect-team.atlassian.net
JIRA_EMAIL=jira-integration@yourcompany.com
JIRA_API_TOKEN=paste-token-from-id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=PCAIDEV
JIRA_ISSUE_TYPE=Task

# Shared with the portal backend; used to sign every request (HMAC-SHA256 of raw body)
PORTAL_SHARED_SECRET=change-me-long-random-string

# Optional: map your portal's status values to Jira status names
# STATUS_MAP_JSON={"todo":"To Do","doing":"In Progress","qa":"In Review","done":"Done"}

# Optional: Sprint / Start date custom field ids (auto-detected by name if left empty)
# JIRA_SPRINT_FIELD=customfield_10020
# JIRA_START_DATE_FIELD=customfield_10015

# Optional: portal changes wait in the page's Inbox until someone approves them (default: off,
# they are checked and sent to Jira straight away)
# PORTAL_REQUIRE_APPROVAL=true

# Optional reverse sync (Jira status/assignee/due date changes and new comments -> portal)
# PORTAL_CALLBACK_URL=https://portal.yourcompany.com/api/jira-callback
# JIRA_WEBHOOK_SECRET=another-random-string

# The settings below can also be set in the page's Settings tab (ADMIN_PASSCODE); values saved there win.

# Optional: AI suggestions (npm install @anthropic-ai/sdk first)
# AI_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5
# AI_DAILY_LIMIT=200

# Optional: Google Sheet sync (changes wait in the Inbox for approval)
# GOOGLE_SA_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# GOOGLE_SA_FILE=C:\path\to\service-account.json
# SHEET_ID=1AbC...xyz
# SHEET_TAB=Sheet1
# SHEET_POLL_MINUTES=1
# auto: sheet edits go to Jira on the next sync (checked first); approve: they wait in the Inbox
# SHEET_SYNC_MODE=auto

# Accounts: people sign in with their email and password (admins add them in Settings -> People).
# ADMIN_PASSCODE is the setup code asked once, to create the first admin (required on Netlify).
ADMIN_PASSCODE=change-me-too
# Signs the sign-in cookies. Optional: without it one is made and kept in the store.
# Set a long random value to share it across servers, or change it to sign everyone out.
# SESSION_SECRET=

# Optional: alerts (channels are set in Settings -> Alerts; these are the defaults)
# APP_URL=https://jira360.example.com
# ALERT_DIGEST_HOUR=8
# ALERT_TIMEZONE=Asia/Kolkata
# For email channels (also: npm install nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=app-password
# SMTP_FROM=Jira360 <alerts@example.com>
# 0.0.0.0 = teammates on the network can open the form; 127.0.0.1 = this computer only
# HOST=0.0.0.0

PORT=8080
