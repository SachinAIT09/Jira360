JIRA_BASE_URL=https://powerconnect-team.atlassian.net
JIRA_EMAIL=jira-integration@yourcompany.com
JIRA_API_TOKEN=paste-token-from-id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=PCAIDEV
JIRA_ISSUE_TYPE=Task

# Shared with the portal backend; used to sign every request (HMAC-SHA256 of raw body)
PORTAL_SHARED_SECRET=change-me-long-random-string

# Optional: map your portal's status values to Jira status names
# STATUS_MAP_JSON={"todo":"To Do","doing":"In Progress","qa":"In Review","done":"Done"}

# Optional: Sprint / Start date custom field ids (auto-detected by name if left empty)
# JIRA_SPRINT_FIELD=customfield_10020
# JIRA_START_DATE_FIELD=customfield_10015

# Optional reverse sync (Jira status change -> portal)
# PORTAL_CALLBACK_URL=https://portal.yourcompany.com/api/jira-callback
# JIRA_WEBHOOK_SECRET=another-random-string

# HTML form: people enter this passcode to use it
UI_PASSCODE=change-me
# 0.0.0.0 = teammates on the network can open the form; 127.0.0.1 = this computer only
# HOST=0.0.0.0

PORT=8080
